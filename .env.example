# Copiá este archivo como .env y completá el valor.
#   cp .env.example .env
# El .env está gitignoreado: tu token nunca se commitea.

# JWT Token de la API pública del INDEC.
# Generalo en https://api.indec.gob.ar/docs -> registrate, verificá el OTP y
# creá el token desde tu perfil. Se muestra UNA SOLA VEZ, guardalo.
# Sin esta variable, `docker compose up` falla con un mensaje explícito.
INDEC_API_TOKEN=
